# NextTrack backend configuration — all values are OPTIONAL.
#
# Playback is resolved via YouTube Music's internal API (ytmusicapi), which needs
# no API key and has no per-day quota, so there is no YOUTUBE_API_KEY any more.
#
# Override these only if the defaults don't suit your environment:

# Comma-separated allowed CORS origins (default: http://localhost:5173,http://localhost:3000)
# CORS_ORIGINS=http://localhost:5173

# Log level (default: INFO)
# LOG_LEVEL=INFO
